# Ambiente da aplicação
NODE_ENV=production
PORT=3000

# O código usa Drizzle com PostgreSQL.
DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/lyra

# Autenticação local / proprietário inicial
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
OWNER_OPEN_ID=owner-local
OWNER_NAME=Administrador
OWNER_EMAIL=admin@exemplo.local

# Segredo para cifrar credenciais de integrações por tenant (mínimo: 32 caracteres)
TENANT_SECRETS_KEY=troque-por-uma-chave-de-32-caracteres-ou-mais

# Código do primeiro admin local (mínimo: 16 caracteres)
LOCAL_AUTH_BOOTSTRAP_CODE=troque-por-um-codigo-seguro-com-16-caracteres

# Billing obrigatório para produção
STRIPE_SECRET_KEY=configure-no-painel-do-stripe
STRIPE_WEBHOOK_SECRET=configure-no-painel-do-stripe

# E-mail transacional opcional até o domínio ser verificado
# RESEND_API_KEY=
# RESEND_FROM=

# Integrações configuradas por tenant, não no ambiente global
# DIFY_API_KEY=
# DIFY_BASE_URL=
# Token de parceiro/integrador da Z-API. Necessário para criar instâncias automaticamente.
# ZAPI_PARTNER_CLIENT_TOKEN=
# Evolution API self-hosted (modo protótipo; não oficial da Meta)
# EVOLUTION_API_URL=http://127.0.0.1:8080
# EVOLUTION_API_KEY=troque-pela-chave-da-sua-evolution
# Percentual aplicado sobre o custo para formar preço interno sugerido (não exibido ao cliente)
# PLATFORM_PROFIT_MARGIN_PERCENT=30
