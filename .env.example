# Ambiente da aplicação
NODE_ENV=production
PORT=3000

# O código atual usa Drizzle com MySQL/MariaDB.
# Para implantação local, informe a URL do banco na VM.
DATABASE_URL=mysql://lyra:troque-esta-senha@127.0.0.1:3306/lyra

# Autenticação local / proprietário inicial
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
OWNER_OPEN_ID=owner-local
OWNER_NAME=Administrador
OWNER_EMAIL=admin@exemplo.local

# Integrações opcionais, conforme a operação da instalação
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DIFY_API_KEY=
# DIFY_BASE_URL=
